{
  "name": "openchat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vp exec tsc -p tsconfig.app.json --noEmit && vp build",
    "build:renderer": "vp exec tsc -p tsconfig.app.json --noEmit && vp build --config vite.renderer.config.ts --base ./ --outDir ../desktop/.vite/build/web-dist --emptyOutDir",
    "preview": "vp preview",
    "test": "vitest run --config vitest.config.worker.ts && vp test --config vitest.config.app.ts",
    "e2e": "playwright test",
    "types": "wrangler types",
    "check": "vp check",
    "db:generate": "drizzle-kit generate --config=drizzle.d1.config.ts && drizzle-kit generate --config=drizzle.user-do.config.ts && drizzle-kit generate --config=drizzle.channel-do.config.ts",
    "deploy": "vp build && wrangler deploy",
    "deploy:dry": "vp build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "catalog:",
    "@aws-sdk/s3-request-presigner": "catalog:",
    "@base-ui/react": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@sqlite.org/sqlite-wasm": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "jose": "catalog:",
    "platform": "workspace:*",
    "protocol": "workspace:*",
    "react": "catalog:",
    "react-dom": "catalog:",
    "realtime": "workspace:*",
    "shadcn": "catalog:",
    "state": "workspace:*",
    "tailwind-merge": "catalog:",
    "tw-animate-css": "catalog:",
    "zod": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/vitest-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  }
}
