{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openchat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openchat",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/d1",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "openchat-files",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "PUSH_Q",
        "queue": "openchat-push",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DO",
        "class_name": "UserDO",
      },
      {
        "name": "CHANNEL_DO",
        "class_name": "ChannelDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserDO", "ChannelDO"],
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "R2_BUCKET_NAME": "openchat-files",
    "VAPID_PUBLIC_KEY": "local-vapid-public-key",
  },
}
