{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openchat-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openchat",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/d1",
    },
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "openchat-files",
    },
  ],
  "send_email": [
    {
      "name": "EMAIL",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "PUSH_Q",
        "queue": "openchat-push",
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "USER_DO",
        "class_name": "UserDO",
      },
      {
        "name": "CHANNEL_DO",
        "class_name": "ChannelDO",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["UserDO", "ChannelDO"],
    },
  ],
  "rules": [
    {
      "type": "Text",
      "globs": ["**/*.sql"],
      "fallthrough": true,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "BETTER_AUTH_TRUSTED_ORIGINS": "http://localhost:5173,http://localhost:4173",
    "R2_BUCKET_NAME": "openchat-files",
    "VAPID_PUBLIC_KEY": "local-vapid-public-key",
    "INVITE_FROM_EMAIL": "noreply@openchat.local",
  },
}
