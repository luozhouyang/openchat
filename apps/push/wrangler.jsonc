{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openchat-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "consumers": [
      {
        "queue": "openchat-push",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "openchat-push-dlq",
      },
    ],
  },
}
