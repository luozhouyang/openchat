{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openchat-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-30",
  "compatibility_flags": ["nodejs_compat"],
  "queues": {
    "consumers": [
      {
        "queue": "openchat-push",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "dead_letter_queue": "openchat-push-dlq",
      },
      {
        "queue": "openchat-thumbnails",
        "max_batch_size": 5,
        "max_batch_timeout": 10,
        "dead_letter_queue": "openchat-push-dlq",
      },
    ],
  },
  "r2_buckets": [
    // NOTE: R2 event notifications are not declarable in wrangler.jsonc
    // (config schema has no r2_buckets[].notifications field). They are set up
    // once via CLI/Dashboard and deliver to the "openchat-thumbnails" queue
    // consumed above:
    //
    //   wrangler r2 bucket notification create openchat-files \
    //     --event-type object-create --queue openchat-thumbnails \
    //     --prefix "uploads/"
    //
    // The consumer accepts both this notification shape (mapped in
    // src/thumbnail.ts fromR2Notification) and the legacy
    // {type:"r2-thumbnail",event:{key,contentType,size}} body.
    {
      "binding": "FILES",
      "bucket_name": "openchat-files",
    },
  ],
  "vars": {
    "THUMBNAIL_API_BASE": "http://localhost:8787",
    "API_BASE": "http://localhost:8787",
    "VAPID_SUBJECT": "mailto:dev@openchat.local",
  },
}
